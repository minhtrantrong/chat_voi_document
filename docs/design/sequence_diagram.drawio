                <mxCell id="sq5-e18" value="delete(docId) — cập nhật lạc quan" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=7;rounded=0;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1557;entryX=0.5;entryY=0.1557;" edge="1" parent="1" source="sq5-v2" target="sq5-v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
