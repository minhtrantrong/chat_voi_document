                <mxCell id="sq5-e29" value="deleteByDocument(docId) — xóa chunk + embedding" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=7;rounded=0;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4877;entryX=0.5;entryY=0.4877;" edge="1" parent="1" source="sq5-v5" target="sq5-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
