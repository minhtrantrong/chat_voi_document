                <mxCell id="sq5-e34" value="xóa khỏi danh sách; toast xác nhận" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=7;dashed=1;rounded=0;strokeColor=#6b7280;strokeWidth=1;fontSize=9;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.6516;entryX=0.5;entryY=0.6516;" edge="1" parent="1" source="sq5-v3" target="sq5-v1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
                <mxCell id="sq5-e35" value="SSE document_deleted(docId)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=7;dashed=1;rounded=0;strokeColor=#6b7280;strokeWidth=1;fontSize=9;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.6844;entryX=0.5;entryY=0.6844;" edge="1" parent="1" source="sq5-v9" target="sq5-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
