                <mxCell id="sq5-v37" value="deleted=true → “Tài liệu đã bị xóa”, aria-disabled" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1576" y="987" width="257" height="30" as="geometry"/></mxCell>
                <mxCell id="sq5-v38" value="&lt;b&gt;[alt]&lt;/b&gt; lỗi xóa storage/index (partial failure)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=3;fontSize=9;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="70" y="1055" width="1900" height="125" as="geometry"/></mxCell>
                <mxCell id="sq5-e39" value="giữ status=DELETING; ghi outbox job bù trừ" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=7;rounded=0;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.8156;entryX=0.5;entryY=0.8156;" edge="1" parent="1" source="sq5-v5" target="sq5-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
                <mxCell id="sq5-e40" value="publish document_delete_pending(docId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=7;rounded=0;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.8484;entryX=0.5;entryY=0.8484;" edge="1" parent="1" source="sq5-v5" target="sq5-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
                <mxCell id="sq5-v41" value="&lt;b&gt;Quy tắc:&lt;/b&gt; AC-06.2 — câu hỏi sau khi xóa không thể truy hồi chunk đã xóa; câu trả lời cũ giữ nguyên văn, chip không mở được (BRU-006)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff7d6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=7;fontSize=9;fontColor=#4b3f10;" vertex="1" parent="1"><mxGeometry x="100" y="1210" width="1840" height="45" as="geometry"/></mxCell>
                <mxCell id="sq5-v42" value="Xóa là idempotent; worker bù trừ chạy lại đến khi storage/vector sạch (outbox pattern). Thao tác trên tài liệu đã bị người khác xóa → 404 + toast + làm mới danh sách." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff7d6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=7;fontSize=9;fontColor=#4b3f10;" vertex="1" parent="1"><mxGeometry x="100" y="1260" width="1840" height="45" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
