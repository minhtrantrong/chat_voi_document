                <mxCell id="dep-v12" value="&lt;b&gt;cvd-api&lt;/b&gt; · 2 replicas&lt;br&gt;REST + SSE&lt;br&gt;2 vCPU / 2 GB mỗi pod&lt;br&gt;HPA 2–6" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="980" y="180" width="270" height="120" as="geometry"/></mxCell>
