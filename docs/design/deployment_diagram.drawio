                <mxCell id="dep-e49" value="egress 443 (allowlist)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;endSize=7;strokeColor=#6b7280;strokeWidth=1;fontSize=9;fontColor=#4b5563;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="dep-v22" target="dep-v34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="690"/><mxPoint x="770" y="720"/><mxPoint x="1830" y="720"/><mxPoint x="1830" y="640"/></Array></mxGeometry></mxCell>
                <mxCell id="dep-e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dep-v24" target="dep-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
                <mxCell id="dep-e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#374151;strokeWidth=1;fontSize=9;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dep-v25" target="dep-v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
                <mxCell id="dep-v52" value="&lt;b&gt;Phương án triển khai&lt;/b&gt;&lt;br&gt;• A (cloud): managed PostgreSQL, S3, Redis, KMS; autoscaling theo OQ-005.&lt;br&gt;• B (on-prem): PostgreSQL + MinIO tự vận hành; LLM self-host (vLLM) nếu OQ-007 yêu cầu.&lt;br&gt;• Cùng một Helm chart; khác biệt chỉ ở endpoint và secret." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff7d6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=7;fontSize=9;fontColor=#4b3f10;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="700" height="90" as="geometry"/></mxCell>
                <mxCell id="dep-v53" value="&lt;b&gt;Luồng &amp;amp; kết nối&lt;/b&gt;&lt;br&gt;• Browser → WAF → Nginx → cvd-api (HTTPS, SSE).&lt;br&gt;• Upload → S3 → Redis job → cvd-worker → pgvector → SSE document_ready.&lt;br&gt;• Hỏi → cvd-api → PostgreSQL/pgvector + LLM/Embedding → SSE token." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff7d6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=7;fontSize=9;fontColor=#4b3f10;" vertex="1" parent="1"><mxGeometry x="760" y="1120" width="700" height="90" as="geometry"/></mxCell>
                <mxCell id="dep-v54" value="&lt;b&gt;Bảo mật &amp;amp; vận hành&lt;/b&gt;&lt;br&gt;• TLS 1.3 ra ngoài, mTLS trong cluster; DB/Redis/S3 chỉ trong private subnet.&lt;br&gt;• Backup mã hóa; không lưu nội dung hội thoại trong analytics (PRD 5.2).&lt;br&gt;• Giám sát p90 first-token, answer_error, queue depth, chi phí AI (RSK-005)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff7d6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=7;fontSize=9;fontColor=#4b3f10;" vertex="1" parent="1"><mxGeometry x="1480" y="1120" width="700" height="90" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
